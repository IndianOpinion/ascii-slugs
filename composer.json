{
    "name": "indianopinion/ascii-slugs",
    "description": "Readable ASCII slugs from titles in Indian scripts, Urdu, Cyrillic, Greek and accented Latin, with a short hashed fallback. Framework-free library plus a thin WordPress plugin.",
    "type": "library",
    "license": "MIT",
    "keywords": ["slug", "transliteration", "devanagari", "hindi", "tamil", "urdu", "permalink", "wordpress", "unicode"],
    "homepage": "https://github.com/IndianOpinion/ascii-slugs",
    "support": {
        "issues": "https://github.com/IndianOpinion/ascii-slugs/issues",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10"
    },
    "suggest": {
        "ext-intl": "Transliterates scripts that have no built-in table through ICU"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\AsciiSlugs\\WordPress\\": "plugin/src/",
            "IndianOpinion\\AsciiSlugs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\AsciiSlugs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
